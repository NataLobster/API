		{
			"name": "Create Task",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const json = pm.response.json();\r",
							"pm.collectionVariables.set(\"currentTask\", json.data.id);\r",
							"\r",
							"\r",
							"// 1.Проверка на код ответа\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"}\r",
							");\r",
							"\r",
							"//2.Название задачи\r",
							"pm.test(\"Name of the task\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.data.name).to.eql('Проблема №1');\r",
							"});\r",
							"\r",
							"//3.Ответственный по задаче\r",
							"pm.test(\"responsible for the task\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.data.responsible.id).to.eql(\"1000005\");\r",
							"});\r",
							"//4.Статус задачи\r",
							"pm.test(\"status of the task\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.data.status).to.eql(\"assigned\");\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
